<?xml version="1.0" encoding="UTF-8"?>
<configs>
	<!--
		Buttons sit in the vanilla container-control row, immediately left of
		btnToggleLockMode. On the public windows.xml layout that control is at
		local 0,-22 inside this rect, so -110/-74/-38 lands in the gap before it.
		The 3.4.0b6 Data/Config XUi files were not in the compile references;
		confirm this xpath and these positions in game.
	-->
	<append xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']">
		<button depth="5" name="btnQuickStackNearby" sprite="ui_game_symbol_store_similar_down" tooltip_key="qspNearbyTip" pos="-110,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
		<button depth="5" name="btnQuickStackVehicle" sprite="ui_game_symbol_minibike" tooltip_key="qspVehicleTip" pos="-74,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
		<button depth="5" name="btnQuickStackVehicleAll" sprite="ui_game_symbol_store_all_down" tooltip_key="qspVehicleAllTip" pos="-38,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
	</append>
</configs>
